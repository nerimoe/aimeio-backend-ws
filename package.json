{
  "name": "aimeio-backend-ws",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tools/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build && bun run test:smoke"
  },
  "dependencies": {
    "hono": "^4.11.8"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.4.0"
  }
}
